# Docker Compose 전용 기본값. 제품 루트 .env와 별도로 사용.
PROXY_PORT=8080
V1_PORT=8101
V2_PORT=8102
DEMO_REQUESTS=100
DEMO_TIMEOUT=5
DEMO_PATH=/items/different
DEMO_V2_RATIO=0
DEMO_SHADOW_ENABLED=false
# 공개된 로컬 데모용 값. 실제 환경에서 사용하지 않음.
DEMO_CONTROL_TOKEN=local-demo-only
# 지정 시 routing과 비교 정책은 이 JSON이 소유.
PROXY_CONFIG=
